{
  "name": "cime",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Collective Intelligence Made Easy",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "install:all": "npm ci --prefix backend && npm ci --prefix frontend && npm ci --prefix admin-frontend",
    "setup:admin": "npm --prefix backend run setup:admin",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:admin": "npm --prefix admin-frontend run dev",
    "start:backend": "npm --prefix backend start",
    "build": "npm --prefix frontend run build && npm --prefix admin-frontend run build",
    "test": "npm --prefix backend test",
    "start": "npm --prefix backend start",
    "format:check": "prettier --check backend/src/platform backend/src/storage backend/test frontend/src/platform admin-frontend/src/platform",
    "server:start": "systemctl --user start cime-db.service cime-platform.service",
    "server:restart": "systemctl --user restart cime-platform.service",
    "server:stop": "systemctl --user stop cime-platform.service",
    "server:status": "systemctl --user status cime-platform.service cime-db.service --no-pager",
    "server:logs": "journalctl --user -u cime-platform.service -n 100 -f"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
