# Local server
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Required: generate a unique value using the README command.
JWT_SECRET=

# Server-side API credential. Supply your own; never put it in a VITE_ variable.
OPENAI_API_KEY=
# CIME_API_KEY is also accepted and takes precedence when set.

# Choose chat models available to your API account.
OPENAI_MODEL=gpt-5.6-sol
CHEAP_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BOT_TRIGGER_HANDLE=@bot

# Initial account creation only. Remove ADMIN_PASSWORD after setup.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional direct TLS (a reverse proxy can terminate TLS instead).
HTTPS_ENABLED=false
# SSL_KEY_PATH=
# SSL_CERT_PATH=
# SSL_CA_PATH=
