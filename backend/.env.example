# Local development: start the portal at http://localhost:5173
PORT=4000
HOST=127.0.0.1
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# At least 32 characters. Preserve this secret across restarts and backups.
JWT_SECRET=
# Server credentials; never put these in VITE_ variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
CHEAP_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BOT_TRIGGER_HANDLE=@bot
# SQLite is used when empty, suitable for local development.
DATABASE_URL=
CIME_DATA_DIR=./data
# Without SMTP, local verification links are shown and saved in data/mail/outbox.jsonl.
SMTP_URL=
MAIL_FROM=CIME <noreply@example.org>
# Production requires NODE_ENV=production, PostgreSQL, SMTP and HTTPS PUBLIC_APP_URL.
# TRUST_PROXY_HOPS=1
MAX_RUN_WORKERS=16
MAX_ACTIVE_RUNS_PER_ADMIN=4
MAX_PARTICIPANTS_PER_RUN=500
MAX_DECISIONS_PER_ADMIN=100
MAX_RUNS_PER_DECISION=50
MAX_LLM_CALLS_PER_RUN=5000
MAX_LLM_CALLS_PER_ADMIN_DAY=10000
MAX_LLM_CONCURRENCY_PER_RUN=4
# Prolific study verification credentials are configured privately per run in the portal.
